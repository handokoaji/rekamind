{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rekamind",
  "version": "0.4.0-beta.9",
  "identifier": "id.rekamind.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; media-src 'self' blob: http://127.0.0.1:* http://localhost:* https:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Rochmad Handoko Aji",
    "copyright": "Copyright (C) 2026 Rochmad Handoko Aji",
    "homepage": "https://github.com/handokoaji/rekamind",
    "shortDescription": "Rekam rapat, dapatkan transkrip, ringkasan, dan task",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Indonesian",
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "pulseaudio-utils"
        ]
      }
    }
  }
}
