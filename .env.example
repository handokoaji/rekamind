POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=meeting_recorder
STORAGE_BACKEND=postgres

# Isi manual setelah dapat API key dari console.groq.com
GROQ_API_KEY=

# Isi manual: buat token read-only di huggingface.co/settings/tokens
# setelah accept terms di huggingface.co/pyannote/speaker-diarization-3.1
# dan huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# Opsional -- identitas perangkat ini untuk multi-device sync. Kosongkan
# untuk pakai default (uuid acak / hostname mesin).
DEVICE_ID=
DEVICE_LABEL=

# Opsional -- sync file lewat MinIO. Kosongkan semua untuk nonaktifkan.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# Opsional -- paksa backend ASR (cuda/openvino/cpu) alih-alih auto-detect
ASR_BACKEND_OVERRIDE=
