# Salin ke .env di samping docker-compose.yml (Portainer: isi di "Environment variables").
# Panduan membuat OAuth client Google: docs/AUTH.md
REKAMIND_PUBLIC_URL=https://rekamind.example.com
REKAMIND_GOOGLE_CLIENT_ID=
REKAMIND_GOOGLE_CLIENT_SECRET=
REKAMIND_SUPERADMINS=anda@example.com
REKAMIND_SIGNUP=allowlist
REKAMIND_ALLOWED_DOMAINS=example.com
# REKAMIND_ALLOWED_EMAILS=
# REKAMIND_ENGINES=none
# REKAMIND_DATABASE_URL=postgresql+asyncpg://rekamind:secret@db:5432/rekamind
REKAMIND_TIMEZONE=Asia/Jakarta
# Wajib bila memakai integrasi task di server bersama (>= 32 karakter acak):
# REKAMIND_SECRET_KEY=
# REKAMIND_INTEGRATIONS_ALLOW_PRIVATE=false
